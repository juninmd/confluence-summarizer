CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token
APP_API_KEY=your-app-api-key
ALLOWED_ORIGINS=["http://localhost:3000"]

# PostgreSQL with the pgvector extension (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/confluence

# Any OpenAI-compatible endpoint. Leave *_BASE_URL empty to use api.openai.com.
# Self-hosted example: vLLM for chat, TEI (or Ollama) for embeddings.
OPENAI_API_KEY=
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-32B
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

BACKUP_DIR=./backup
BACKUP_CONCURRENCY=5
DUPLICATE_THRESHOLD=0.85
DB_PATH=jobs.db
